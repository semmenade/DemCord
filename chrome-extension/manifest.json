{
    "manifest_version": 3,
    "name": "DemCord",
    "version": "2.5.0",
    "description": "The demon-powered Discord client mod for Discord Web",
    "permissions": ["scripting", "storage", "webRequest"],
    "host_permissions": ["https://discord.com/*", "https://discordapp.com/*"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [{
        "matches": ["https://discord.com/*", "https://discordapp.com/*"],
        "js": ["content.js"],
        "run_at": "document_start"
    }],
    "action": {
        "default_popup": "popup.html",
        "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
    },
    "web_accessible_resources": [{
        "resources": ["patcher.js", "preload.js", "renderer.js", "renderer.css"],
        "matches": ["https://discord.com/*"]
    }]
}
